{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "can-i-park-here",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": false }
}
